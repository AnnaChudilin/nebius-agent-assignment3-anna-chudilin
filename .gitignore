# === Virtual Environments ===
# Isolates the project's virtual environments
.ai3/
.venv/
venv/
env/

# === Secret Keys & Local Configurations ===
# Prevents API keys and credentials from being leaked to GitHub
.env
.env.local

# === Databases & State Checkpoints ===
# Prevents committing local session history (the database will be created fresh by the grader)
checkpoints/checkpoints.db
*.db
*.sqlite
*.db-shm
*.db-wal

# === Python Cache & Build Files ===
# Removes temporary compiled Python files and testing caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Operating System Trash ===
# Isolates system-specific metadata files generated by macOS and Windows
.DS_Store
Thumbs.db

# === Streamlit Configuration ===
# Excludes local runtime configurations, theme overwrites, or port binds
.streamlit/config.toml

# === Data Files & Outputs ===
*.json


*.csv
*.pdf
tests/__init__.py
